<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Alap tema: vilagos (nem DayNight), igy a sotet mod nem irja felul a palettat.
         ActionBarral: ezt hasznalja a PointCloudActivity. -->
    <style name="Theme.Sfm_vc_ocv" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/brown</item>
        <item name="colorPrimaryVariant">@color/beige_dark</item>
        <item name="colorOnPrimary">@color/beige</item>
        <item name="colorSecondary">@color/brown</item>
        <item name="colorOnSecondary">@color/beige</item>

        <item name="android:windowBackground">@color/beige</item>
        <item name="android:textColorPrimary">@color/dark_brown</item>

        <!-- Allapotsor: a fejlec szine, sotet ikonokkal -->
        <item name="android:statusBarColor">@color/beige_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="actionBarStyle">@style/MyActionBar</item>
        <item name="android:actionBarStyle">@style/MyActionBar</item>
        <item name="actionBarTheme">@style/MyActionBarTheme</item>
    </style>

    <!-- A MainActivity (Compose) temaja: ActionBar nelkul, a fejlecet a Compose TopAppBar adja -->
    <style name="Theme.Sfm_vc_ocv.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="MyActionBar" parent="@style/Widget.MaterialComponents.ActionBar.Solid">
        <item name="titleTextStyle">@style/MyActionBarTitle</item>
        <item name="android:titleTextStyle">@style/MyActionBarTitle</item>
        <item name="background">@color/beige_dark</item>
        <item name="android:background">@color/beige_dark</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- A vissza nyil (colorControlNormal) es a cim sotetbarna -->
    <style name="MyActionBarTheme" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="colorControlNormal">@color/dark_brown</item>
        <item name="android:textColorPrimary">@color/dark_brown</item>
    </style>

    <style name="MyActionBarTitle" parent="@style/TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/dark_brown</item>
    </style>
</resources>
